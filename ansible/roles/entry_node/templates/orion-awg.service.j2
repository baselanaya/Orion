[Unit]
Description=Orion entry node client-facing obfuscated tunnel (awg0)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/awg-quick up /etc/amnezia/awg0.conf
ExecStop=/usr/bin/awg-quick down /etc/amnezia/awg0.conf

[Install]
WantedBy=multi-user.target
