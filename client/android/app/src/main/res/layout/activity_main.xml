<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1A2B">

    <TextView
        android:id="@+id/brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        android:text="ORION"
        android:textColor="#E9EEF8"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:textSize="20sp"
        android:letterSpacing="0.34"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/stateChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:text="UNPROTECTED"
        android:textColor="#8E94A8"
        android:fontFamily="monospace"
        android:textSize="10.5sp"
        android:letterSpacing="0.14"
        app:layout_constraintTop_toTopOf="@id/brand"
        app:layout_constraintBottom_toBottomOf="@id/brand"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/serversLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="20dp"
        android:text="SERVERS"
        android:textColor="#8E94A8"
        android:fontFamily="monospace"
        android:textSize="9.5sp"
        android:letterSpacing="0.16"
        app:layout_constraintTop_toBottomOf="@id/brand"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/serverScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="170dp"
        app:layout_constraintTop_toBottomOf="@id/serversLabel"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/serverList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </ScrollView>

    <dev.orion.mobile.RingView
        android:id="@+id/ringView"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/serverScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/powerBtn"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/power_ring"
        android:src="@drawable/ic_power"
        android:contentDescription="connect or disconnect"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="@id/ringView"
        app:layout_constraintBottom_toBottomOf="@id/ringView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/stateWord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="20dp"
        android:text="STANDBY"
        android:textColor="#E9EEF8"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:textSize="44sp"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toBottomOf="@id/ringView"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/profileView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="profile: none"
        android:textColor="#8E94A8"
        android:fontFamily="monospace"
        android:textSize="10.5sp"
        app:layout_constraintTop_toBottomOf="@id/hud"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/subline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="Traffic unconfined."
        android:textColor="#8E94A8"
        android:textSize="12.5sp"
        app:layout_constraintTop_toBottomOf="@id/stateWord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="#101219"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/subline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="rx" android:textColor="#8E94A8" android:fontFamily="monospace" android:textSize="10sp" />
            <TextView android:id="@+id/rx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#E9EEF8" android:fontFamily="monospace" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="tx" android:textColor="#8E94A8" android:fontFamily="monospace" android:textSize="10sp" />
            <TextView android:id="@+id/tx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#E9EEF8" android:fontFamily="monospace" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="handshake" android:textColor="#8E94A8" android:fontFamily="monospace" android:textSize="10sp" />
            <TextView android:id="@+id/hs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#E9EEF8" android:fontFamily="monospace" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/powerBtn2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="#E9EEF0"
        app:backgroundTint="#4C7DF0"
        android:text="CONNECT"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:letterSpacing="0.14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
